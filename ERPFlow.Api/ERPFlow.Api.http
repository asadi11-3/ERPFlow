@ERPFlow.Api_HostAddress = https://localhost:7165
@Email = sales@erpflow.local
@Password = SET_WITH_DemoUsers__Password
@Token = PASTE_ACCESS_TOKEN

POST {{ERPFlow.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

GET {{ERPFlow.Api_HostAddress}}/api/reference/customers
Authorization: Bearer {{Token}}

