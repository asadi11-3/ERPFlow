{
  "name": "erpflow-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:monsterasp": "ng build --configuration production,monsterasp",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:hosting": "node --test worker.test.ts",
    "lint": "ng lint",
    "deploy": "npm run build && wrangler deploy",
    "deploy:monsterasp": "npm run build:monsterasp && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.2.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "chart.js": "^4.6.1",
    "rxjs": "~7.8.0",
    "tom-select": "^2.6.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.152.0"
  }
}
