{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erpflow-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "dist/erpflow-web/browser",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
